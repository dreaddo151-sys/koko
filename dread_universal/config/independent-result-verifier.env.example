# Copy to /etc/dread-result-verifier.env and replace every placeholder.
# Keep this file root-owned and mode 0600; systemd reads it before dropping privileges.
DREAD_VERIFIER_DB_PATH=/path/to/canonical-phase6.sqlite
DREAD_INDEPENDENT_RESULT_VERIFIER_RECEIPT_DIR=/var/lib/dread-verifier/receipts
DREAD_INDEPENDENT_RESULT_VERIFIER_ID=dread-independent-result-verifier
DREAD_INDEPENDENT_RESULT_VERIFIER_KEY_ID=replace-with-pinned-key-id
DREAD_INDEPENDENT_RESULT_VERIFIER_PRIVATE_KEY_FILE=/var/lib/dread-verifier/config/verifier.pk8
DREAD_INDEPENDENT_RESULT_VERIFIER_PUBLIC_KEY_HEX=replace-with-64-hex-character-ed25519-public-key
DREAD_INDEPENDENT_RESULT_VERIFIER_POLICY_FILE=/var/lib/dread-verifier/config/policy.json
DREAD_INDEPENDENT_RESULT_VERIFIER_RECEIPT_UID=replace-with-verifier-numeric-uid
DREAD_INDEPENDENT_RESULT_VERIFIER_RECEIPT_GID=replace-with-api-shared-group-numeric-gid
DREAD_VERIFIER_POLL_INTERVAL_SECONDS=5
