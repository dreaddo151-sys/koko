[Unit]
Description=PROJECT DREAD bounded Rust API watchdog
Documentation=https://github.com/dreaddo151-sys/koko
After=default.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/dread-universal/dread.env
ExecStart=/usr/bin/python3 @DREAD_WATCHDOG_SCRIPT@ --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@DREAD_WATCHDOG_STATE_DIR@
