# PROJECT DREAD Universal — copy to a private environment file and replace placeholders.
# Keep the API loopback-only until remote-access security is separately implemented.
DREAD_BIND=127.0.0.1:8765
DREAD_DB_PATH=data/dread_registry.sqlite3
# Production API serves the built React console from this directory.
DREAD_WEB_ROOT=web/dist
# Generate a random secret of at least 32 characters and uncomment:
# DREAD_API_TOKEN=REPLACE_ME_WITH_A_RANDOM_SECRET
DREAD_OPERATOR_ID=local-operator

# llama.cpp OpenAI-compatible gateway. Ollama is not an active backend.
DREAD_GPU_GATEWAY_URL=http://127.0.0.1:11500

# Optional authenticated GPU Supervisor bridge. Configure both values together.
# Store the real token outside the repository with restrictive permissions.
# DREAD_GPU_SUPERVISOR_URL=http://127.0.0.1:11502
# DREAD_GPU_SUPERVISOR_TOKEN=REPLACE_ME_WITH_SUPERVISOR_BRIDGE_TOKEN

DREAD_SERVICES_CONFIG=config/services.toml
DREAD_AGENTS_CONFIG=config/agents.toml

# Root folder must contain skills/ and optionally agents/.
# Set this to the actual local Pstack checkout on each host.
# DREAD_SKILLS_ROOT=/absolute/path/to/pstack
DREAD_PSTACK_VERSION=0.15.43
DREAD_PSTACK_REVISION=2f87c854fe3e2fcda44ca86b46ede35aad3c46b7
