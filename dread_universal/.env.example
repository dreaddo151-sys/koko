# PROJECT DREAD Universal — copy to a private environment file and replace placeholders.
# Keep the API loopback-only until remote-access security is separately implemented.
DREAD_BIND=127.0.0.1:8765
DREAD_DB_PATH=data/dread_registry.sqlite3
# Production API serves the built React console from this directory.
DREAD_WEB_ROOT=web/dist
# Generate a random secret of at least 32 characters and uncomment:
# DREAD_API_TOKEN=REPLACE_ME_WITH_A_RANDOM_SECRET
DREAD_OPERATOR_ID=local-operator

# llama.cpp OpenAI-compatible gateway. Ollama is not an active backend.
DREAD_GPU_GATEWAY_URL=http://127.0.0.1:11500

# Optional authenticated GPU Supervisor bridge. Configure both values together.
# Store the real token outside the repository with restrictive permissions.
# DREAD_GPU_SUPERVISOR_URL=http://127.0.0.1:11502
# DREAD_GPU_SUPERVISOR_TOKEN=REPLACE_ME_WITH_SUPERVISOR_BRIDGE_TOKEN

DREAD_SERVICES_CONFIG=config/services.toml
DREAD_AGENTS_CONFIG=config/agents.toml

# Root folder must contain skills/ and optionally agents/.
# Set this to the actual local Pstack checkout on each host.
# DREAD_SKILLS_ROOT=/absolute/path/to/pstack
DREAD_PSTACK_VERSION=0.15.43
DREAD_PSTACK_REVISION=2f87c854fe3e2fcda44ca86b46ede35aad3c46b7

# Agent task providers are opt-in. Leave these unset until the provider endpoint,
# credentials, tool policy and per-task isolation have been verified.
# Supplying any variable in a provider group activates that group; incomplete
# configuration fails API startup. Never commit real tokens or API keys.

# Hermes Runs API. Backend must be a supported isolated terminal backend.
# DREAD_HERMES_API_URL=http://127.0.0.1:18080
# DREAD_HERMES_API_KEY=REPLACE_ME_WITH_HERMES_API_KEY
# DREAD_HERMES_SANDBOX_BACKEND=REPLACE_WITH_VERIFIED_ISOLATED_BACKEND
# DREAD_HERMES_ISOLATED_WORKSPACE_PER_TASK=true

# DeerFlow LangGraph Gateway. Provider must be AIO or BoxLite; remote
# provisioners and LocalSandboxProvider are intentionally rejected.
# DREAD_DEERFLOW_API_URL=http://127.0.0.1:8001
# DREAD_DEERFLOW_PAT=REPLACE_ME_WITH_DEERFLOW_PAT
# DREAD_DEERFLOW_SANDBOX_PROVIDER=AIO
# DREAD_DEERFLOW_ISOLATED_WORKSPACE_PER_TASK=true
# DREAD_DEERFLOW_API_PREFIX=/api/langgraph
# Leave DREAD_DEERFLOW_PROVISIONER_URL unset; non-empty remote provisioners are rejected.

# OpenHands Agent Server. Use an explicit-port numeric loopback URL.
# On the Agent Server, configure either:
#   OH_CONVERSATION_RUNTIME=docker
# or local default + per-conversation Docker selection:
#   OH_CONVERSATION_RUNTIME=local
#   OH_CONVERSATION_RUNTIME_SELECTABLE=1
# Keep OH_SECRET_KEY in the Agent Server's private secret store and stable across restarts.
# DREAD checks authenticated GET /server_info; it refuses task creation unless Docker
# is the active runtime or "docker" appears in available_conversation_runtimes.
# The DREAD *_ENABLED / *_CONFIGURED booleans below are operator attestations only.
# DREAD_OPENHANDS_API_URL=http://127.0.0.1:18000
# DREAD_OPENHANDS_SESSION_API_KEY=REPLACE_ME_WITH_OPENHANDS_SESSION_KEY
# DREAD_OPENHANDS_LLM_MODEL=REPLACE_WITH_APPROVED_MODEL
# DREAD_OPENHANDS_LLM_API_KEY=REPLACE_ME_WITH_LLM_API_KEY
# This endpoint is reached from the per-conversation Docker container.
# DREAD_OPENHANDS_LLM_BASE_URL=http://host.docker.internal:11500/v1
# DREAD_OPENHANDS_DOCKER_RUNTIME_ENABLED=true
# DREAD_OPENHANDS_SECRET_STORE_CONFIGURED=true
