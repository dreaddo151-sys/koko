# PROJECT DREAD Universal — copy to a private .env file and replace placeholders.
# The API deliberately binds to loopback until remote-access security is separately implemented.
DREAD_BIND=127.0.0.1:8765
DREAD_DB_PATH=data/dread_registry.sqlite3
DREAD_API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DREAD_OPERATOR_ID=local-operator

# llama.cpp OpenAI-compatible gateway. Ollama is not an active backend.
DREAD_GPU_GATEWAY_URL=http://127.0.0.1:11500

# Optional authenticated GPU Supervisor bridge. Keep the token in a mode-600 secret file.
DREAD_GPU_SUPERVISOR_URL=http://127.0.0.1:11502
DREAD_GPU_SUPERVISOR_TOKEN=REPLACE_WITH_SUPERVISOR_BRIDGE_TOKEN

DREAD_SERVICES_CONFIG=config/services.toml
DREAD_AGENTS_CONFIG=config/agents.toml

# Root folder must contain skills/ and optionally agents/.
DREAD_SKILLS_ROOT=../integrations/cursor-plugins/pstack
DREAD_PSTACK_VERSION=0.15.43
DREAD_PSTACK_REVISION=2f87c854fe3e2fcda44ca86b46ede35aad3c46b7
