# Copy to ~/.config/dread/api.env and chmod 600.
# Generate a private token locally; never commit or paste it.
DREAD_API_TOKEN=
DREAD_BIND=127.0.0.1:8765
DREAD_DB_PATH=data/dread_registry.sqlite3
DREAD_COMFYUI_URL=http://127.0.0.1:8188
# Enable only after the existing Python Supervisor bridge is configured:
# DREAD_GPU_SUPERVISOR_URL=http://127.0.0.1:11502
# DREAD_GPU_SUPERVISOR_TOKEN=
