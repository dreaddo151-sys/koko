[Unit]
Description=PROJECT DREAD Universal Rust API
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/dread_rust_redesign/dread_universal
EnvironmentFile=-%h/.config/dread/api.env
ExecStart=%h/dread_rust_redesign/dread_universal/target/release/dread-universal
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=900
StartLimitBurst=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/dread_rust_redesign/dread_universal/data %h/.local/state/dread

[Install]
WantedBy=default.target
