+async fn probe_agent(client: Client, agent: AgentEndpoint) -> AgentProbeResult {
+    if !agent.enabled {
+        return AgentProbeResult {
+            id: agent.id,
+            name: agent.name,
+            adapter: agent.adapter,
+            health_url: agent.health_url,
+            enabled: false,
+            status: "DISABLED".into(),
+            http_status: None,
+            latency_ms: None,
+            detail: "Configured but disabled; no network request was made".into(),
+        };
+    }
+    let started = Instant::now();
+    match client.get(&agent.health_url).send().await {
+        Ok(response) => {
+            let code = response.status().as_u16();
+            AgentProbeResult {
+                id: agent.id,
+                name: agent.name,
+                adapter: agent.adapter,
+                health_url: agent.health_url,
+                enabled: true,
+                status: classify_agent_http_status(code).into(),
+                http_status: Some(code),
+                latency_ms: Some(started.elapsed().as_millis()),
+                detail: agent_status_detail(code).into(),
+            }
+        }
+        Err(error) => AgentProbeResult {
+            id: agent.id,
+            name: agent.name,
+            adapter: agent.adapter,
+            health_url: agent.health_url,
+            enabled: true,
+            status: if error.is_timeout() { "UNKNOWN" } else { "OFFLINE" }.into(),
+            http_status: None,
+            latency_ms: Some(started.elapsed().as_millis()),
+            detail: if error.is_timeout() { "Connection timed out" } else { "Endpoint could not be reached" }.into(),
+        },
+    }
+}
