+pub fn load_agents(path: &str) -> Result<Vec<AgentEndpoint>, String> {
+    let contents = fs::read_to_string(path).map_err(|e| format!("Cannot read {path}: {e}"))?;
+    let config: AgentConfig = toml::from_str(&contents)
+        .map_err(|e| format!("Invalid agent configuration: {e}"))?;
+    if config.agents.len() > 32 {
+        return Err("Agent configuration exceeds the 32 endpoint safety limit".into());
+    }
+    let mut ids = std::collections::HashSet::new();
+    for agent in &config.agents {
+        if agent.id.trim().is_empty()
+            || agent.name.trim().is_empty()
+            || agent.adapter.trim().is_empty()
+            || agent.id.len() > 128
+            || agent.name.len() > 200
+            || agent.adapter.len() > 128
+            || !ids.insert(agent.id.as_str())
+        {
+            return Err(format!("Invalid or duplicate local agent definition: {}", agent.id));
+        }
+        validate_local_service_url(&agent.health_url)
+            .map_err(|_| format!("Agent {} must use an explicit-port loopback HTTP health URL", agent.id))?;
+    }
+    Ok(config.agents)
+}
